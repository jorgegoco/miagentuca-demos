# API Keys (set real values in Easypanel environment variables, never commit real keys)
VISION_AGENT_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# LandingAI region: "eu" or "us"
ADE_ENVIRONMENT=eu

# Service configuration
PORT=8007
HOST=0.0.0.0
DEBUG=False
MAX_FILE_SIZE_MB=20

# Pre-load medical papers on startup (set to false to skip during dev)
PRELOAD_ENABLED=true

# Session management
SESSION_TTL_HOURS=2

# Storage paths (mount as Docker volumes in Easypanel)
CHROMA_DB_PATH=/app/chroma_data
UPLOADED_PDFS_DIR=/app/uploaded_pdfs
CHUNK_IMAGES_DIR=/app/chunk_images
