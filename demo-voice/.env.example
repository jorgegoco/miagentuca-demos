# Vocal Bridge credentials (dashboard → API keys / agent settings). Never commit the real values.
VOCAL_BRIDGE_API_KEY=vb_xxxxxxxxxxxxxxxx
VOCAL_BRIDGE_AGENT_ID_VOICE=your-agent-id

# Comma-separated list of origins allowed to call POST /token from a browser
ALLOWED_ORIGINS=https://miagentuca.es,http://localhost:5173
